<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.aggitech</groupId>
    <artifactId>aggo</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>

    <name>aggo</name>
    <description>Reflection-free Kotlin DSL on top of R2DBC/Postgres — internal Dabble utility lib.</description>
    <url>https://github.com/Aggi-tech/aggo</url>
    <inceptionYear>2024</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>yurimoinhos</id>
            <name>Yuri Moinhos</name>
            <email>moinhosyuri@gmail.com</email>
            <organization>Aggitech</organization>
            <organizationUrl>https://github.com/Aggi-tech</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/Aggi-tech/aggo.git</connection>
        <developerConnection>scm:git:ssh://github.com/Aggi-tech/aggo.git</developerConnection>
        <url>https://github.com/Aggi-tech/aggo/tree/main</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/Aggi-tech/aggo/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <kotlin.version>2.3.21</kotlin.version>
        <kotlin.code.style>official</kotlin.code.style>

        <coroutines.version>1.10.2</coroutines.version>
        <r2dbc-spi.version>1.0.0.RELEASE</r2dbc-spi.version>
        <r2dbc-pool.version>1.0.2.RELEASE</r2dbc-pool.version>
        <r2dbc-postgresql.version>1.1.1.RELEASE</r2dbc-postgresql.version>
        <!-- S-1 (CVE-2025-59432): scram:common:2.1 has a timing side-channel in
             SCRAM authentication (Arrays.equals instead of constant-time compare).
             r2dbc-postgresql 1.1.x depends on the fixed SCRAM 3.x artifacts:
             common -> scram-common, client -> scram-client. -->
        <scram.version>3.2</scram.version>
        <slf4j.version>2.0.16</slf4j.version>

        <kotest.version>5.9.1</kotest.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <junit.version>5.11.4</junit.version>

        <maven-enforcer.version>3.5.0</maven-enforcer.version>
        <surefire.version>3.5.2</surefire.version>
        <maven.source.version>3.3.1</maven.source.version>
        <maven.antrun.version>3.1.0</maven.antrun.version>
        <maven.jar.version>3.5.0</maven.jar.version>
        <maven.gpg.version>3.2.7</maven.gpg.version>
        <central.publishing.version>0.10.0</central.publishing.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Aligns coroutines-core, -reactive (and any tests pulling -jdk8 /
                 -debug) to a single version; kills the silent classpath drift
                 visible in `mvn dependency:tree` (kotest pulled 1.8.0 modules). -->
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-bom</artifactId>
                <version>${coroutines.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- S-1 (CVE-2025-59432): keep the driver on the fixed SCRAM 3.x
                 line and prevent dependency mediation from selecting 2.x. -->
            <dependency>
                <groupId>com.ongres.scram</groupId>
                <artifactId>scram-client</artifactId>
                <version>${scram.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ongres.scram</groupId>
                <artifactId>scram-common</artifactId>
                <version>${scram.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Single Kotlin runtime — kotlin-stdlib-jdk7/-jdk8 were merged into
             kotlin-stdlib in 1.8+; we are on 2.3.21. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-spi</artifactId>
            <version>${r2dbc-spi.version}</version>
        </dependency>
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-pool</artifactId>
            <version>${r2dbc-pool.version}</version>
        </dependency>
        <!-- r2dbc-postgresql 1.1.x is compiled against SCRAM 3.x, avoiding the
             mixed 2.x/3.x classpath that broke SCRAM auth at runtime. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>r2dbc-postgresql</artifactId>
            <version>${r2dbc-postgresql.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core-jvm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-reactive</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>io.kotest</groupId>
            <artifactId>kotest-runner-junit5-jvm</artifactId>
            <version>${kotest.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kotest</groupId>
            <artifactId>kotest-assertions-core-jvm</artifactId>
            <version>${kotest.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-test</artifactId>
            <version>${coroutines.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                    <javaParameters>true</javaParameters>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals><goal>compile</goal></goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <goals><goal>test-compile</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer.version}</version>
                <executions>
                    <execution>
                        <id>ban-vulnerable-scram</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- CVE-2025-59432 / GHSA-3wfh-36rx-9537 affects SCRAM before 3.2. -->
                                        <exclude>com.ongres.scram:common</exclude>
                                        <exclude>com.ongres.scram:client</exclude>
                                        <exclude>com.ongres.scram:scram-common:[,3.2)</exclude>
                                        <exclude>com.ongres.scram:scram-client:[,3.2)</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>

            <!-- -sources.jar required by Maven Central -->
            <plugin>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals><goal>jar-no-fork</goal></goals>
                        <configuration>
                            <classifier>sources</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-cli</id>
                        <configuration>
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Default deployment target: GitHub Packages -->
    <distributionManagement>
        <repository>
            <id>github-aggi-tech</id>
            <name>GitHub Packages — Aggi-tech/aggo</name>
            <url>https://maven.pkg.github.com/Aggi-tech/aggo</url>
        </repository>
    </distributionManagement>

    <profiles>
        <!--
          Maven Central publishing profile.

          Activation: mvn deploy -P central

          Prerequisites (one-time setup):
          1. Register namespace com.aggitech at https://central.sonatype.com
          2. Generate a User Token at central.sonatype.com → Account → Generate User Token
          3. Create a GPG key: gpg -\-full-generate-key
          4. Export the private key: gpg -\-export-secret-keys -\-armor KEY_ID
          5. Add GitHub repository secrets:
               CENTRAL_USERNAME  (token username from step 2)
               CENTRAL_PASSWORD  (token password from step 2)
               GPG_PRIVATE_KEY   (output from step 4)
               GPG_PASSPHRASE    (passphrase chosen in step 3)
          6. Upload public key: gpg -\-keyserver keyserver.ubuntu.com -\-send-keys KEY_ID
        -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <!-- GPG signing — required by Maven Central -->
                    <plugin>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Javadoc jar required by Maven Central. This is a Kotlin-only
                         project, so the standard Javadoc plugin has no Java sources
                         to process; attach a small documentation placeholder instead. -->
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>${maven.antrun.version}</version>
                        <executions>
                            <execution>
                                <id>prepare-kotlin-javadocs</id>
                                <phase>prepare-package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/apidocs"/>
                                        <echo file="${project.build.directory}/apidocs/README.txt">
Aggo is implemented in Kotlin. Public API documentation is provided by the sources artifact.
                                        </echo>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>${maven.jar.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.build.directory}/apidocs</classesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Sonatype Central Publishing plugin -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central.publishing.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
